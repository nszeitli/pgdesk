# Copy to .env in the directory from which you run `uv run pgdesk`.
# Or use `pgdesk --config /path/to/.env`. Never commit .env.
# These are references, not passwords/API keys. AWS CLI must be installed and
# authenticated for the named profiles. A configured AWS secret is authoritative:
# authentication errors never silently fall back to a different credential source.
PGDESK_CLUSTERS=test,prod
PGDESK_POOL_SIZE=2
PGDESK_ROW_LIMIT=10000
PGDESK_STATEMENT_TIMEOUT_SECONDS=120

# Cluster IDs start with a letter, use letters/digits/underscores, and are unique
# ignoring case. OPENAI is reserved. Settings use uppercase prefixes.
# NAME is the tab label. Add more IDs to PGDESK_CLUSTERS as needed.
# Ctrl+N reloads choices; reopen existing tabs to apply changed cluster references.
PGDESK_TEST_NAME=test
PGDESK_TEST_AWS_PROFILE=test-local
PGDESK_TEST_AWS_REGION=us-west-2
PGDESK_TEST_SECRET_ID=your-test-rds-secret
PGDESK_TEST_MAINTENANCE_DATABASE=postgres
PGDESK_TEST_PRODUCTION=false

PGDESK_PROD_NAME=prod
PGDESK_PROD_AWS_PROFILE=production-local
PGDESK_PROD_AWS_REGION=us-west-2
PGDESK_PROD_SECRET_ID=your-production-rds-secret
PGDESK_PROD_MAINTENANCE_DATABASE=postgres
PGDESK_PROD_PRODUCTION=true

# RDS JSON fields: host, port, username, password. Database credentials are fetched
# for each physical connection. TLS verifies the hostname and certificate;
# install the RDS CA bundle in ~/.postgresql/root.crt (libpq's trust location).
# Optional database allowlist instead of discovery; a quoted JSON array:
# PGDESK_TEST_DATABASES='["domain1", "domain2"]'
# Instead of the three AWS fields, a cluster may use exactly one of:
# PGDESK_TEST_SERVICE=your-libpq-service
# PGDESK_TEST_DSN_ENV=YOUR_PROCESS_DSN_VARIABLE
# DSN_ENV names a separately exported variable; its value does not belong here.

# Remove all four OpenAI entries to use an externally supplied OPENAI_API_KEY.
# Restart after changing these authentication references. F9 edits model/reasoning/
# Fast mode/system prompt preferences, which persist separately in settings.json.
PGDESK_OPENAI_AWS_PROFILE=production-local
PGDESK_OPENAI_AWS_REGION=us-west-2
PGDESK_OPENAI_SECRET_ID=miscellaneous
PGDESK_OPENAI_KEY_PATH=slack_agent.openai_api_key
